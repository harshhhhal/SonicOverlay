{
  "manifest_version": 3,
  "name": "SonicOverlay",
  "version": "1.0.0",
  "description": "Real-time audio visualizer overlay for Spotify Web Player. Transparent, click-through, and tinted by the current album art.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "permissions": [
    "storage",
    "tabCapture",
    "offscreen",
    "activeTab"
  ],
  "host_permissions": [
    "https://open.spotify.com/*",
    "https://i.scdn.co/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "action": {
    "default_title": "SonicOverlay",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "settings/settings.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://open.spotify.com/*"
      ],
      "js": [
        "utils/message-types.js",
        "utils/validation.js",
        "utils/color-utils.js",
        "utils/dom-utils.js",
        "storage/settings-store.js",
        "storage/preset-store.js",
        "audio/audio-analysis.js",
        "visualizers/renderer-manager.js",
        "visualizers/common.js",
        "visualizers/classic-spectrum.js",
        "visualizers/radial-spectrum.js",
        "visualizers/circular-waveform.js",
        "visualizers/linear-waveform.js",
        "visualizers/mirrored-spectrum.js",
        "visualizers/frequency-curve.js",
        "visualizers/dot-spectrum.js",
        "visualizers/stacked-spectrum.js",
        "visualizers/particle-field.js",
        "visualizers/ambient-orbs.js",
        "visualizers/album-art-ring.js",
        "visualizers/minimal-equalizer.js",
        "visualizers/neon-oscilloscope.js",
        "visualizers/liquid-ribbon.js",
        "visualizers/aurora-flow.js",
        "visualizers/frequency-mountain.js",
        "visualizers/vortex-tunnel.js",
        "visualizers/starfield-drift.js",
        "visualizers/plasma-orbit.js",
        "visualizers/concentric-pulse.js",
        "visualizers/glitch-spectrum.js",
        "visualizers/equalizer-matrix.js",
        "visualizers/spectrum-ribbon.js",
        "visualizers/orbiting-particles.js",
        "content/spotify-meta.js",
        "settings/settings.js",
        "content/spotify-content.js"
      ],
      "css": [
        "content/overlay.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content/overlay.css",
        "settings/settings.css"
      ],
      "matches": [
        "https://open.spotify.com/*"
      ]
    }
  ],
  "commands": {
    "toggle-overlay": {
      "suggested_key": {
        "default": "Alt+Shift+V"
      },
      "description": "Show or hide the visualizer overlay"
    },
    "toggle-panel": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Show or hide the settings panel"
    },
    "toggle-edit": {
      "suggested_key": {
        "default": "Alt+Shift+E"
      },
      "description": "Toggle layout edit mode"
    },
    "toggle-capture": {
      "suggested_key": {
        "default": "Alt+Shift+C"
      },
      "description": "Start or stop audio capture"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}